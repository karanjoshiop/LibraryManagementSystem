@page "/books/create"
@attribute [Authorize]
@using LibraryManagementSystem.Models.Dtos
@inject IBookService BookSvc
@inject NavigationManager Nav

<PageTitle>New book - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>New book</h1>
        <p class="text-muted mb-0">Add a book and link it to one or more authors.</p>
    </div>
    <a href="books" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to list
    </a>
</div>

@if (isLoading)
{
    <div class="card"><div class="card-body text-muted">Loading…</div></div>
}
else
{
    <div class="card">
        <div class="card-body" style="max-width: 720px;">
            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                    </div>
                }

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <InputText id="title" class="form-control" @bind-Value="model.Title" />
                    <ValidationMessage For="@(() => model.Title)" />
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label for="isbn" class="form-label">ISBN</label>
                        <InputText id="isbn" class="form-control" @bind-Value="model.ISBN" />
                        <ValidationMessage For="@(() => model.ISBN)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="category" class="form-label">Category</label>
                        <InputSelect id="category" class="form-select" @bind-Value="model.CategoryId">
                            <option value="0">-- Select category --</option>
                            @foreach (var category in formData.Categories)
                            {
                                <option @key="category.CategoryId" value="@category.CategoryId">@category.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => model.CategoryId)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="copies" class="form-label">Total copies</label>
                    <InputNumber id="copies" class="form-control" @bind-Value="model.TotalCopies" />
                    <ValidationMessage For="@(() => model.TotalCopies)" />
                </div>

                <div class="mb-4">
                    <label class="form-label">Authors <span class="text-muted small">(select one or more)</span></label>
                    <div class="border rounded p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var author in formData.Authors)
                        {
                            <div @key="author.AuthorId" class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="@($"author-{author.AuthorId}")"
                                       checked="@selectedAuthorIds.Contains(author.AuthorId)"
                                       @onchange="@(e => ToggleAuthor(author.AuthorId, e.Value))" />
                                <label class="form-check-label" for="@($"author-{author.AuthorId}")">
                                    @author.FullName
                                </label>
                            </div>
                        }
                    </div>
                    @if (authorError)
                    {
                        <div class="validation-message">Select at least one author.</div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                    <a href="books" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private BookFormData formData = new(new(), new());
    private readonly BookInput model = new();
    private readonly HashSet<int> selectedAuthorIds = new();
    private bool isLoading = true;
    private bool authorError;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        formData = await BookSvc.GetFormDataAsync();
        isLoading = false;
    }

    private void ToggleAuthor(int id, object? value)
    {
        authorError = false;
        if (value is bool checkedValue)
        {
            if (checkedValue) selectedAuthorIds.Add(id);
            else selectedAuthorIds.Remove(id);
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        authorError = selectedAuthorIds.Count == 0;
        if (authorError) return;

        model.AuthorIds = selectedAuthorIds.ToList();

        if (!await BookSvc.CreateAsync(model))
        {
            errorMessage = "Could not save. Check that the ISBN is unique and all fields are valid.";
            return;
        }

        Nav.NavigateTo("/books");
    }
}
