@page "/reservations/edit/{Id:long}"
@attribute [Authorize]
@using LibraryManagementSystem.Models.Dtos
@inject IReservationService ReservationSvc
@inject NavigationManager Nav

<PageTitle>Edit reservation - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>Edit reservation</h1>
        <p class="text-muted mb-0">Update the reservation status.</p>
    </div>
    <a href="reservations" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to list
    </a>
</div>

@if (notFound)
{
    <div class="card"><div class="card-body"><div class="alert alert-warning mb-0">Reservation not found.</div></div></div>
}
else if (isLoading)
{
    <div class="card"><div class="card-body text-muted">Loading…</div></div>
}
else
{
    <div class="card">
        <div class="card-body" style="max-width: 640px;">
            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                    </div>
                }

                <dl class="row small text-muted">
                    <dt class="col-sm-2">Book</dt><dd class="col-sm-10">@item.BookTitle</dd>
                    <dt class="col-sm-2">Member</dt><dd class="col-sm-10">@item.MemberName</dd>
                    <dt class="col-sm-2">Reserved</dt><dd class="col-sm-10">@item.ReservedAt.ToString("dd MMM yyyy HH:mm")</dd>
                </dl>

                <div class="mb-4">
                    <label for="status" class="form-label">Status</label>
                    @if (NextStatuses.Length == 0)
                    {
                        <input id="status" class="form-control" value="@item.Status" readonly />
                    }
                    else
                    {
                        <InputSelect id="status" class="form-select" @bind-Value="model.Status">
                            @foreach (var status in NextStatuses)
                            {
                                <option @key="status" value="@status">@status</option>
                            }
                        </InputSelect>
                    }
                </div>

                @if (NextStatuses.Length == 0)
                {
                    <div class="alert alert-secondary small">
                        This reservation is final and its status cannot be changed.
                    </div>
                }

                <div class="d-flex gap-2">
                    @if (NextStatuses.Length > 0)
                    {
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save changes
                        </button>
                    }
                    <a href="reservations" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public long Id { get; set; }

    private ReservationDto item = default!;
    private readonly ReservationInput model = new();
    private bool isLoading = true;
    private bool notFound;
    private string? errorMessage;

    private string[] NextStatuses => item?.Status switch
    {
        "Pending" => new[] { "Fulfilled", "Cancelled", "Expired" },
        _ => Array.Empty<string>()
    };

    protected override async Task OnInitializedAsync()
    {
        var existing = await ReservationSvc.GetByIdAsync(Id);
        if (existing is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        item = existing;
        model.BookId = existing.BookId;
        model.MemberId = existing.MemberId;
        model.Status = NextStatuses.Length > 0 ? NextStatuses[0] : existing.Status;

        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (!await ReservationSvc.UpdateAsync(Id, model))
        {
            errorMessage = "Could not save the reservation.";
            return;
        }

        Nav.NavigateTo("/reservations");
    }
}
