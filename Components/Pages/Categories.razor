@page "/categories"
@attribute [Authorize]
@using LibraryManagementSystem.Models.Dtos
@inherits ListPageBase<CategoryDto>
@inject ICategoryService CategorySvc

<PageTitle>Categories - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>Categories</h1>
        <p class="text-muted mb-0">Manage the categories used to organise books.</p>
    </div>
    <a href="categories/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New category
    </a>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
    </div>
}

<div class="card">
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4 text-muted">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                Loading…
            </div>
        }
        else
        {
            <ListToolbar SearchText="@SearchText"
                         SearchTextChanged="OnSearchChanged"
                         Placeholder="Search name or description"
                         ItemLabel="categories"
                         PageNumber="@PageNumber"
                         PageNumberChanged="OnPageChanged"
                         PageSize="@PageSize"
                         PageSizeChanged="OnPageSizeChanged"
                         TotalPages="@TotalPages"
                         TotalCount="@TotalCount" />

            @if (AllItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No categories found.
                </div>
            }
            else if (FilteredItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-search fs-1 d-block mb-2"></i>
                    No categories match your search.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 70px;">Id</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th style="width: 230px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in PageItems)
                            {
                                <tr @key="category.CategoryId">
                                    <td class="text-muted">@category.CategoryId</td>
                                    <td class="fw-semibold">@category.Name</td>
                                    <td class="text-muted">@category.Description</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            @if (pendingDeleteId == category.CategoryId)
                                            {
                                                <span class="small me-1">Delete?</span>
                                                <button class="btn btn-sm btn-danger"
                                                        @onclick="() => ConfirmDeleteAsync(category.CategoryId)">
                                                    Yes
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => pendingDeleteId = null">
                                                    Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <a href="@($"categories/edit/{category.CategoryId}")"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => pendingDeleteId = category.CategoryId">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private int? pendingDeleteId;

    protected override IEnumerable<string?> GetSearchValues(CategoryDto category) => new[]
    {
        category.Name,
        category.Description
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        AllItems = await CategorySvc.GetAllAsync();
        ClampPage();
        isLoading = false;
    }

    private async Task ConfirmDeleteAsync(int id)
    {
        pendingDeleteId = null;
        errorMessage = null;

        if (!await CategorySvc.DeleteAsync(id))
        {
            errorMessage = "Cannot delete: this category is used by one or more books.";
            return;
        }

        await LoadAsync();
    }
}
