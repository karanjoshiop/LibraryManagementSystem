@page "/membership-types"
@attribute [Authorize]
@using LibraryManagementSystem.Models.Dtos
@inherits ListPageBase<MembershipTypeDto>
@inject IMembershipTypeService TypeSvc

<PageTitle>Membership types - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>Membership types</h1>
        <p class="text-muted mb-0">Define plans, borrowing limits and loan periods.</p>
    </div>
    <a href="membership-types/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New type
    </a>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
    </div>
}

<div class="card">
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4 text-muted">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                Loading…
            </div>
        }
        else
        {
            <ListToolbar SearchText="@SearchText"
                         SearchTextChanged="OnSearchChanged"
                         Placeholder="Search plan name"
                         ItemLabel="plans"
                         FilterOptions="@FilterOptions"
                         SelectedFilter="@SelectedFilter"
                         SelectedFilterChanged="OnFilterChanged"
                         PageNumber="@PageNumber"
                         PageNumberChanged="OnPageChanged"
                         PageSize="@PageSize"
                         PageSizeChanged="OnPageSizeChanged"
                         TotalPages="@TotalPages"
                         TotalCount="@TotalCount" />

            @if (AllItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No membership types found.
                </div>
            }
            else if (FilteredItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-search fs-1 d-block mb-2"></i>
                    No plans match your search or filter.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th style="width: 110px;">Duration</th>
                                <th style="width: 100px;">Fee</th>
                                <th style="width: 110px;">Borrow limit</th>
                                <th style="width: 120px;">Loan period</th>
                                <th style="width: 100px;">Status</th>
                                <th style="width: 230px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in PageItems)
                            {
                                <tr @key="type.MembershipTypeId">
                                    <td class="fw-semibold">@type.Name</td>
                                    <td class="text-muted">@type.DurationMonths mo</td>
                                    <td>@type.Fee.ToString("C")</td>
                                    <td>@type.BorrowLimit</td>
                                    <td class="text-muted">@type.LoanPeriodDays days</td>
                                    <td>
                                        <span class="badge @(type.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                            @(type.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            @if (pendingDeleteId == type.MembershipTypeId)
                                            {
                                                <span class="small me-1">Delete?</span>
                                                <button class="btn btn-sm btn-danger"
                                                        @onclick="() => ConfirmDeleteAsync(type.MembershipTypeId)">
                                                    Yes
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => pendingDeleteId = null">
                                                    Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <a href="@($"membership-types/edit/{type.MembershipTypeId}")"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => pendingDeleteId = type.MembershipTypeId">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private int? pendingDeleteId;

    protected override IReadOnlyList<string> FilterOptions =>
        new[] { "All", "Active", "Inactive" };

    protected override IEnumerable<string?> GetSearchValues(MembershipTypeDto type) => new[] { type.Name };

    protected override bool MatchesFilter(MembershipTypeDto type) => SelectedFilter switch
    {
        "Active" => type.IsActive,
        "Inactive" => !type.IsActive,
        _ => true
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        AllItems = await TypeSvc.GetAllAsync();
        ClampPage();
        isLoading = false;
    }

    private async Task ConfirmDeleteAsync(int id)
    {
        pendingDeleteId = null;
        errorMessage = null;

        if (!await TypeSvc.DeleteAsync(id))
        {
            errorMessage = "Cannot delete: this type is used by one or more memberships.";
            return;
        }

        await LoadAsync();
    }
}
