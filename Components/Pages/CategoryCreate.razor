@page "/categories/create"
@attribute [Authorize]
@using LibraryManagementSystem.Models.Dtos
@inject ICategoryService CategorySvc
@inject NavigationManager Nav

<PageTitle>New category - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>New category</h1>
        <p class="text-muted mb-0">Add a new category to organise your books.</p>
    </div>
    <a href="categories" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to list
    </a>
</div>

<div class="card">
    <div class="card-body" style="max-width: 640px;">
        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                </div>
            }

            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <InputText id="name" class="form-control" @bind-Value="model.Name" />
                <ValidationMessage For="@(() => model.Name)" />
            </div>

            <div class="mb-4">
                <label for="description" class="form-label">Description</label>
                <InputTextArea id="description" class="form-control" rows="4"
                               @bind-Value="model.Description" />
                <ValidationMessage For="@(() => model.Description)" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Save
                </button>
                <a href="categories" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly CategoryInput model = new();
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        errorMessage = null;
        if (!await CategorySvc.CreateAsync(model))
        {
            errorMessage = "A category with this name already exists.";
            return;
        }

        Nav.NavigateTo("/categories");
    }
}
