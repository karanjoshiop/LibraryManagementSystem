@page "/memberships"
@attribute [Authorize]
@using LibraryManagementSystem.Models.Dtos
@inherits ListPageBase<MembershipDto>
@inject IMembershipService MembershipSvc

<PageTitle>Memberships - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>Memberships</h1>
        <p class="text-muted mb-0">Track member plans, payments and status.</p>
    </div>
    <a href="memberships/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New membership
    </a>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
    </div>
}

<div class="alert alert-light border small">
    <i class="bi bi-info-circle me-1"></i>
    Free plans show as <strong>Free</strong> and are always settled. Use <strong>Renew</strong> after a plan
    ends or <strong>Upgrade</strong> to move to a higher plan; both keep the old record in History.
</div>

<div class="card">
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4 text-muted">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                Loading…
            </div>
        }
        else
        {
            <ListToolbar SearchText="@SearchText"
                         SearchTextChanged="OnSearchChanged"
                         Placeholder="Search member, plan or payment"
                         ItemLabel="memberships"
                         FilterOptions="@FilterOptions"
                         SelectedFilter="@SelectedFilter"
                         SelectedFilterChanged="OnFilterChanged"
                         TabOptions="@TabOptions"
                         SelectedTab="@SelectedTab"
                         SelectedTabChanged="OnTabChanged"
                         PageNumber="@PageNumber"
                         PageNumberChanged="OnPageChanged"
                         PageSize="@PageSize"
                         PageSizeChanged="OnPageSizeChanged"
                         TotalPages="@TotalPages"
                         TotalCount="@TotalCount" />

            @if (AllItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No memberships found.
                </div>
            }
            else if (FilteredItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-search fs-1 d-block mb-2"></i>
                    No @SelectedTab.ToLowerInvariant() memberships match your search or filter.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Member</th>
                                <th>Type</th>
                                <th style="width: 110px;">Start</th>
                                <th style="width: 110px;">End</th>
                                <th style="width: 100px;">Payment</th>
                                <th style="width: 100px;">Status</th>
                                <th style="width: 330px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PageItems)
                            {
                                <tr @key="item.MembershipId">
                                    <td class="fw-semibold">@item.MemberName</td>
                                    <td><span class="badge bg-primary-subtle text-primary-emphasis">@item.TypeName</span></td>
                                    <td class="text-muted">@item.StartDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-muted">@item.EndDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge @(item.TypeFee == 0m || item.PaymentStatus == "Paid" ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                                            @(item.TypeFee == 0m ? "Free" : item.PaymentStatus)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(IsLive(item) ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                            @(IsLive(item) ? "Active" : item.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (pendingDeleteId == item.MembershipId)
                                            {
                                                <span class="small me-1">Delete?</span>
                                                <button class="btn btn-sm btn-danger"
                                                        @onclick="() => ConfirmDeleteAsync(item.MembershipId)">Yes</button>
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => pendingDeleteId = null">Cancel</button>
                                            }
                                            else
                                            {
                                                @if (IsLive(item) && CanUpgrade(item))
                                                {
                                                    <a href="@($"memberships/upgrade/{item.MemberId}")"
                                                       class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-arrow-up-circle"></i> Upgrade
                                                    </a>
                                                }
                                                else if (!IsLive(item) && CanRenew(item))
                                                {
                                                    <button class="btn btn-sm btn-outline-success"
                                                            @onclick="() => RenewAsync(item.MembershipId)">
                                                        <i class="bi bi-arrow-repeat"></i> Renew
                                                    </button>
                                                }
                                                <a href="@($"memberships/edit/{item.MembershipId}")"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => pendingDeleteId = item.MembershipId">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<MembershipTypeDto> planTypes = new();
    private bool isLoading = true;
    private string? errorMessage;
    private int? pendingDeleteId;

    protected override IReadOnlyList<string> FilterOptions =>
        new[] { "All", "Paid", "Pending" };

    protected override IReadOnlyList<string> TabOptions =>
        new[] { "Active", "History" };

    protected override IEnumerable<string?> GetSearchValues(MembershipDto item) => new[]
    {
        item.MemberName,
        item.TypeName,
        item.PaymentStatus,
        item.Status
    };

    protected override bool MatchesFilter(MembershipDto item) => SelectedFilter switch
    {
        "Paid" => item.TypeFee == 0m || item.PaymentStatus == "Paid",
        "Pending" => item.TypeFee > 0m && item.PaymentStatus == "Pending",
        _ => true
    };

    protected override bool MatchesTab(MembershipDto item) =>
        SelectedTab != "History" ? IsLive(item) : !IsLive(item);

    private static bool IsLive(MembershipDto item) =>
        item.Status == "Active" && item.EndDate >= DateOnly.FromDateTime(DateTime.Today);

    // Only offer Renew when this member has no other live plan (e.g. an old
    // expired row left behind after an upgrade).
    private bool CanRenew(MembershipDto item) =>
        !IsLive(item) && !AllItems.Any(x => x.MemberId == item.MemberId
                                         && x.MembershipId != item.MembershipId
                                         && IsLive(x));

    // A member already on the highest-priced active plan has nothing to upgrade to.
    private bool CanUpgrade(MembershipDto item) =>
        planTypes.Count > 0 && item.TypeFee < planTypes.Max(t => t.Fee);

    protected override async Task OnInitializedAsync()
    {
        SelectedTab = "Active";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Date-based expiry is applied first so stored statuses stay in sync.
        await MembershipSvc.RefreshExpiriesAsync();
        AllItems = await MembershipSvc.GetAllAsync();
        planTypes = (await MembershipSvc.GetFormDataAsync()).Types
            .Where(t => t.IsActive)
            .ToList();
        ClampPage();
        isLoading = false;
    }

    private async Task RenewAsync(int id)
    {
        errorMessage = null;
        if (!await MembershipSvc.RenewAsync(id))
        {
            errorMessage = "Could not renew this membership. Check that the member is active and has no other live plan.";
            return;
        }

        // Show the freshly renewed row in the Active tab.
        SelectedTab = "Active";
        PageNumber = 1;
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync(int id)
    {
        pendingDeleteId = null;
        errorMessage = null;

        if (!await MembershipSvc.DeleteAsync(id))
        {
            errorMessage = "Could not delete this membership.";
            return;
        }

        await LoadAsync();
    }
}
