@page "/loans"
@attribute [Authorize]
@using LibraryManagementSystem.Models.Dtos
@inherits ListPageBase<LoanDto>
@inject ILoanService LoanSvc

<PageTitle>Loans - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>Loans</h1>
        <p class="text-muted mb-0">Issue books, track returns and fines.</p>
    </div>
    <a href="loans/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Issue book
    </a>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
    </div>
}

<div class="card">
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4 text-muted">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                Loading…
            </div>
        }
        else
        {
            <ListToolbar SearchText="@SearchText"
                         SearchTextChanged="OnSearchChanged"
                         Placeholder="Search book, member or status"
                         ItemLabel="loans"
                         FilterOptions="@FilterOptions"
                         SelectedFilter="@SelectedFilter"
                         SelectedFilterChanged="OnFilterChanged"
                         TabOptions="@TabOptions"
                         SelectedTab="@SelectedTab"
                         SelectedTabChanged="OnTabChanged"
                         PageNumber="@PageNumber"
                         PageNumberChanged="OnPageChanged"
                         PageSize="@PageSize"
                         PageSizeChanged="OnPageSizeChanged"
                         TotalPages="@TotalPages"
                         TotalCount="@TotalCount" />

            @if (AllItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No loans found.
                </div>
            }
            else if (FilteredItems.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-search fs-1 d-block mb-2"></i>
                    No @SelectedTab.ToLowerInvariant() loans match your search or filter.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Book</th>
                                <th>Member</th>
                                <th style="width: 100px;">Issued</th>
                                <th style="width: 100px;">Due</th>
                                <th style="width: 100px;">Returned</th>
                                <th style="width: 100px;">Fine</th>
                                <th style="width: 100px;">Status</th>
                                <th style="width: 230px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PageItems)
                            {
                                <tr @key="item.LoanId">
                                    <td class="fw-semibold">@item.BookTitle</td>
                                    <td class="text-muted">@item.MemberName</td>
                                    <td class="text-muted">@item.IssueDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-muted">@item.DueDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-muted">@(item.ReturnDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td>
                                        @if (item.FineAmount > 0)
                                        {
                                            <span>@item.FineAmount.ToString("C")</span>
                                            @if (item.FinePaidAmount > 0)
                                            {
                                                <span class="d-block small text-success">@item.FinePaidAmount.ToString("C") paid</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(item.Status == "Returned" ? "bg-success-subtle text-success-emphasis" : item.Status == "Overdue" ? "bg-danger-subtle text-danger-emphasis" : "bg-primary-subtle text-primary-emphasis")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            @if (pendingDeleteId == item.LoanId)
                                            {
                                                <span class="small me-1">Delete?</span>
                                                <button class="btn btn-sm btn-danger"
                                                        @onclick="() => ConfirmDeleteAsync(item.LoanId)">
                                                    Yes
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => pendingDeleteId = null">
                                                    Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <a href="@($"loans/edit/{item.LoanId}")"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i> @(item.ReturnDate is null ? "Return" : "Edit")
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => pendingDeleteId = item.LoanId">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private long? pendingDeleteId;

    protected override IReadOnlyList<string> FilterOptions =>
        new[] { "All", "Overdue", "Has fine" };

    protected override IReadOnlyList<string> TabOptions =>
        new[] { "Active", "History" };

    protected override IEnumerable<string?> GetSearchValues(LoanDto loan) => new[]
    {
        loan.BookTitle,
        loan.MemberName,
        loan.Status
    };

    protected override bool MatchesFilter(LoanDto loan) => SelectedFilter switch
    {
        "Overdue" => loan.Status == "Overdue",
        "Has fine" => loan.FineAmount - loan.FinePaidAmount > 0m,
        _ => true
    };

    protected override bool MatchesTab(LoanDto loan) =>
        SelectedTab != "History" ? loan.ReturnDate is null : loan.ReturnDate is not null;

    protected override async Task OnInitializedAsync()
    {
        SelectedTab = "Active";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Newest first; returned loans appear in descending return date order.
        AllItems = (await LoanSvc.GetAllAsync())
            .OrderByDescending(l => l.ReturnDate ?? l.IssueDate)
            .ThenByDescending(l => l.LoanId)
            .ToList();
        ClampPage();
        isLoading = false;
    }

    private async Task ConfirmDeleteAsync(long id)
    {
        pendingDeleteId = null;
        errorMessage = null;

        if (!await LoanSvc.DeleteAsync(id))
        {
            errorMessage = "Could not delete this loan.";
            return;
        }

        await LoadAsync();
    }
}
