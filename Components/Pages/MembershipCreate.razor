@page "/memberships/create"
@attribute [Authorize]
@using System.Globalization
@using LibraryManagementSystem.Models.Dtos
@inject IMembershipService MembershipSvc
@inject NavigationManager Nav

<PageTitle>New membership - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>New membership</h1>
        <p class="text-muted mb-0">Assign a membership plan to a member.</p>
    </div>
    <a href="memberships" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to list
    </a>
</div>

@if (isLoading)
{
    <div class="card"><div class="card-body text-muted">Loading…</div></div>
}
else
{
    <div class="card">
        <div class="card-body" style="max-width: 680px;">
            <EditForm Model="@model"
                      OnValidSubmit="HandleSubmit"
                      OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label for="member" class="form-label">Member</label>
                        <InputSelect id="member" class="form-select" @bind-Value="model.MemberId">
                            <option value="0">-- Select member --</option>
                            @foreach (var member in formData.Members)
                            {
                                <option @key="member.MemberId" value="@member.MemberId">@member.FullName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => model.MemberId)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="type" class="form-label">Membership type</label>
                        <InputSelect id="type" class="form-select" @bind-Value="model.MembershipTypeId"
                                     @bind-Value:after="OnTypeChanged">
                            <option value="0">-- Select type --</option>
                            @foreach (var type in formData.Types)
                            {
                                <option @key="type.MembershipTypeId" value="@type.MembershipTypeId">@type.Name (@type.Fee.ToString("C"))</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => model.MembershipTypeId)" />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label for="start" class="form-label">Start date</label>
                        <input id="start" type="date" class="form-control"
                               value="@startDateText"
                               @onchange="OnStartDateInputChanged" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="end" class="form-label">End date</label>
                        <input id="end" type="date" class="form-control"
                               min="@startDateText"
                               value="@endDateText"
                               @onchange="OnEndDateInputChanged" />
                    </div>
                    @if (dateRangeError is not null)
                    {
                        <div class="col-12"><div class="text-danger small">@dateRangeError</div></div>
                    }
                    <div class="col-12">
                        <div class="form-text">
                            Saving as: <strong>@startDateText</strong> to <strong>@endDateText</strong>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label for="payment" class="form-label">Payment status</label>
                        <InputSelect id="payment" class="form-select" @bind-Value="model.PaymentStatus"
                                     disabled="@IsFreePlan">
                            <option value="Pending">Pending</option>
                            <option value="Paid">Paid</option>
                        </InputSelect>
                        @if (IsFreePlan)
                        {
                            <div class="form-text">Free plan — recorded as Paid automatically.</div>
                        }
                        <ValidationMessage For="@(() => model.PaymentStatus)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="status" class="form-label">Status</label>
                        <InputSelect id="status" class="form-select" @bind-Value="model.Status">
                            <option value="Active">Active</option>
                            <option value="Expired">Expired</option>
                            <option value="Cancelled">Cancelled</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => model.Status)" />
                        @if (model.Status == "Active" && model.EndDate < DateOnly.FromDateTime(DateTime.Today))
                        {
                            <div class="form-text text-warning">
                                An end date in the past will be saved as Expired.
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@(dateRangeError is not null)">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                    <a href="memberships" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private MembershipFormData formData = new(new(), new());
    private readonly MembershipInput model = new();
    private string startDateText = "";
    private string endDateText = "";
    private bool isLoading = true;
    private bool IsFreePlan;
    private string? errorMessage;
    private string? dateRangeError;

    protected override async Task OnInitializedAsync()
    {
        formData = await MembershipSvc.GetFormDataAsync();
        startDateText = model.StartDate.ToString("yyyy-MM-dd");
        endDateText = model.EndDate.ToString("yyyy-MM-dd");
        OnTypeChanged();
        isLoading = false;
    }

    private void OnTypeChanged()
    {
        var type = formData.Types
            .FirstOrDefault(t => t.MembershipTypeId == model.MembershipTypeId);
        IsFreePlan = type?.Fee == 0m;

        // Do not overwrite dates the librarian already entered.
        if (IsFreePlan) model.PaymentStatus = "Paid";
    }

    private void OnStartDateInputChanged(ChangeEventArgs args)
    {
        startDateText = args.Value?.ToString() ?? string.Empty;
        ValidateDateRange();
    }

    private void OnEndDateInputChanged(ChangeEventArgs args)
    {
        endDateText = args.Value?.ToString() ?? string.Empty;

        if (DateOnly.TryParseExact(endDateText, "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var end))
        {
            model.Status = end < DateOnly.FromDateTime(DateTime.Today)
                ? "Expired"
                : model.Status == "Expired" ? "Active" : model.Status;
        }

        ValidateDateRange();
    }

    private void ValidateDateRange()
    {
        dateRangeError = null;
        if (DateOnly.TryParseExact(startDateText, "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var start)
            && DateOnly.TryParseExact(endDateText, "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var end)
            && end < start)
        {
            dateRangeError = "End date cannot be before the start date.";
        }
    }

    private bool TrySyncDates(out string? error)
    {
        error = null;

        if (!DateOnly.TryParseExact(startDateText, "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var start)
            || !DateOnly.TryParseExact(endDateText, "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var end))
        {
            error = "Please enter both dates in yyyy-MM-dd format.";
            return false;
        }

        if (end < start)
        {
            error = "End date cannot be before the start date.";
            return false;
        }

        model.StartDate = start;
        model.EndDate = end;
        model.Status = end < DateOnly.FromDateTime(DateTime.Today)
            ? "Expired"
            : model.Status == "Expired" ? "Active" : model.Status;
        return true;
    }

    private void HandleInvalidSubmit()
    {
        errorMessage = "Please fix the highlighted fields before saving.";
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (!TrySyncDates(out var dateError))
        {
            errorMessage = dateError;
            return;
        }

        if (!await MembershipSvc.CreateAsync(model))
        {
            errorMessage = "Could not save. Check the dates and make sure the member has no other active membership.";
            return;
        }

        Nav.NavigateTo("/memberships");
    }
}
