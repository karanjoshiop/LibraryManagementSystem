@page "/categories/edit/{Id:int}"
@attribute [Authorize]
@using LibraryManagementSystem.Models.Dtos
@inject ICategoryService CategorySvc
@inject NavigationManager Nav

<PageTitle>Edit category - Library Management</PageTitle>

<div class="page-header">
    <div>
        <h1>Edit category</h1>
        <p class="text-muted mb-0">Update the category details.</p>
    </div>
    <a href="categories" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to list
    </a>
</div>

@if (notFound)
{
    <div class="card">
        <div class="card-body">
            <div class="alert alert-warning mb-0">Category not found.</div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body" style="max-width: 640px;">
            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                    </div>
                }

                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="model.Name" />
                    <ValidationMessage For="@(() => model.Name)" />
                </div>

                <div class="mb-4">
                    <label for="description" class="form-label">Description</label>
                    <InputTextArea id="description" class="form-control" rows="4"
                                   @bind-Value="model.Description" />
                    <ValidationMessage For="@(() => model.Description)" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save changes
                    </button>
                    <a href="categories" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private readonly CategoryInput model = new();
    private string? errorMessage;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        var category = await CategorySvc.GetByIdAsync(Id);
        if (category is null)
        {
            notFound = true;
            return;
        }

        model.Name = category.Name;
        model.Description = category.Description;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        if (!await CategorySvc.UpdateAsync(Id, model))
        {
            errorMessage = "A category with this name already exists.";
            return;
        }

        Nav.NavigateTo("/categories");
    }
}
