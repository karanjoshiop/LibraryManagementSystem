@inherits LayoutComponentBase

<div class="app-shell">
    <AuthorizeView>
        <Authorized>
            <aside class="app-sidebar">
                <NavMenu />
            </aside>

            <div class="app-main">
                <header class="app-topbar">
                    <div class="topbar-user">
                        <span class="user-avatar"><i class="bi bi-person-circle"></i></span>
                        <span>@context.User.Identity?.Name</span>
                        <span class="badge bg-primary-subtle text-primary-emphasis">Librarian</span>
                    </div>
                    <form method="post" action="/account/logout" class="m-0" data-no-enhance>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-box-arrow-right me-1"></i>Sign out
                        </button>
                    </form>
                </header>

                <main class="app-content">
                    @Body
                </main>
            </div>
        </Authorized>
        <NotAuthorized>
            <main class="app-content w-100">
                @Body
            </main>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="/" class="reload">Reload</a>
    <a class="dismiss" onclick="this.parentElement.style.display='none'; return false;">
        <i class="bi bi-x"></i>
    </a>
</div>
